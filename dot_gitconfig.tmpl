[user]
	name = loukiano
	email = {{ .email }}
[alias]
	co = checkout
	ci = commit
	ciam = !git add -A && git commit -m
	s = status
	last = log -1 HEAD
	unstage = reset HEAD --
	cob = checkout -b
# Account-local git settings (not in this repo), e.g. work signing key or url rewrites.
# Included last, so anything in it overrides the settings above.
[include]
	path = ~/.gitconfig.local
